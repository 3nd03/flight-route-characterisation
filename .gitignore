__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# raw source data is large (100MB-2GB per file) and not meant to live in git;
# data/processed/ (the query-ready output) IS tracked, it is small and is the point of the repo
data/raw/*
!data/raw/.gitkeep

# SQLite cache (cache_db.py) - a derived, regenerable local cache, same
# reasoning as df_full.parquet never having been committed either. Unlike
# CSVs, a binary DB file also diffs badly in git on every regeneration.
data/processed/cache.db
data/processed/_variance_batches/
data/processed/df_full.parquet
data/processed/_local_run_checkpoint/

notebooks/backups/
~$*.docx
run_log.txt

# working report drafts stay local-only; docs/images/ and
# docs/full_dataset_results/ are the public dissemination outputs
docs/report_draft.md
docs/report_final.docx
docs/report_blueprint.md
docs/technical_documentation.md
